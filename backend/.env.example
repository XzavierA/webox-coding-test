# Local database and Redis used by application-local.yml.
WEBOX_DB_URL=jdbc:mysql://127.0.0.1:3306/webox?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
WEBOX_DB_USER=root
WEBOX_DB_PASSWORD=
WEBOX_REDIS_HOST=127.0.0.1
WEBOX_REDIS_PORT=6379
WEBOX_REDIS_PASSWORD=

# Replace with a randomly generated value of at least 32 bytes.
WEBOX_JWT_SECRET=replace-with-a-local-random-secret-of-at-least-32-bytes

# Optional. If set, local startup creates these accounts with BCrypt hashes.
WEBOX_DEMO_ADMIN_PASSWORD=
WEBOX_DEMO_EMPLOYEE_PASSWORD=
